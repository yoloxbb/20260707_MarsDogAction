<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>marsdog_action_executor</name>
  <version>0.1.0</version>
  <description>MarsDog bionic robot dog behavior execution engine — converts behavior_name goals into staged action plans and drives execution.</description>
  <maintainer email="dev@marsdog.local">MarsDog Dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>

  <!--
    Public interface dependency: ExecuteBehavior.action will eventually
    come from marsdog_interfaces.  Until that package is created, we
    generate the action locally as a fallback.
    <depend>marsdog_interfaces</depend>
  -->

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
